Algoritmo sin_titulo
	Escribir 'inserte sus calificaciones'
	Leer calificacion1
	Leer calificacion2
	Leer calificacion3
	promedio <- (calificacion1+calificacion2+calificacion3)/3
	Escribir 'este es tu promedio: ', promedio
	Si promedio>=6 Entonces
		Escribir 'estas aprovado'
	SiNo
		Escribir 'estas reprobado'
	FinSi
FinAlgoritmo
